# General
PORT=1907
NODE_ENV=development

# WAJIB sama persis dengan JWT_SECRET di apps/habbit-tracker-api/.env
# agar session (cookie) bisa dipakai lintas app.
JWT_SECRET=change-me-to-a-long-random-string

# Shared session cookie across subdomains, contoh: .pasutri.com
# Kosongkan saat development di localhost (cookie otomatis shared karena cookie mengabaikan port).
COOKIE_DOMAIN=

# Database Provider selection: mysql | supabase | neondb
DB_PROVIDER=mysql

# MySQL Configuration (if DB_PROVIDER=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=habbit_couple
MYSQL_PORT=3306

# Supabase / PostgreSQL Configuration (if DB_PROVIDER=supabase)
# DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

ALLOW_ORIGIN_CORS=http://localhost:5175,http://localhost:5173,http://localhost:5174
