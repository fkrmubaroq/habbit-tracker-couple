# Konfigurasi Deployment VPS
# Duplikasi file ini menjadi .env.deploy di folder scripts/ atau root project:
# cp scripts/.env.deploy.example scripts/.env.deploy

# IP atau domain VPS
VPS_HOST="43.134.25.137"

# User SSH VPS (contoh: root, ubuntu, debian)
VPS_USER="ubuntu"

# Port SSH VPS (default: 22)
VPS_PORT="22"

# Lokasi Private Key SSH (opsional, jika menggunakan key-based auth)
# VPS_SSH_KEY="~/.ssh/id_rsa"

# Direktori tujuan di VPS
REMOTE_PATH="/var/www/habbit-tracker"

# Nama aplikasi di PM2
PM2_APP_NAME="habbit-backend"

# Jalankan database migrations otomatis saat deploy? (true/false)
RUN_MIGRATIONS="false"

# Otomatis restart PM2 setelah upload backend? (true/false)
RESTART_PM2="true"
