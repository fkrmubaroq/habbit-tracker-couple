{
  "name": "habbit-tracker-couple",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:migrate": "turbo run db:migrate --filter=@repo/habbit-tracker-api",
    "db:seed": "turbo run db:seed --filter=@repo/habbit-tracker-api",
    "clean": "turbo run clean",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@12.9.1"
}
