{
  "name": "habbit-tracker-couple",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --dir backend dev\" \"pnpm --dir frontend dev\"",
    "build": "pnpm --dir backend build && pnpm --dir frontend build",
    "db:migrate": "pnpm --dir backend db:migrate",
    "db:seed": "pnpm --dir backend db:seed",
    "install:all": "pnpm --dir backend install && pnpm --dir frontend install",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
